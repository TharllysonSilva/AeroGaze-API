# ---- Copie este arquivo para .env e ajuste. NUNCA suba o .env para o Git. ----
NODE_ENV=development
PORT=3000

# Banco (docker compose local). Em produção, use a URL do Postgres gerenciado.
DATABASE_URL=postgresql://aerogaze:aerogaze_dev@localhost:5432/aerogaze

# Gere um valor longo e aleatório: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=12h

# Em desenvolvimento, o primeiro envio de um aparelho novo o cadastra sozinho. Em produção: false.
AUTO_REGISTER_DEVICES=true

# Geofence / GPS
GEOFENCE_MAX_ACCURACY_M=30
GEOFENCE_MARGIN_M=15
GEOFENCE_CONSECUTIVE_READINGS=3
# Tempo mínimo (s) entre a 1ª e a última leitura fora do perímetro para confirmar a violação
GEOFENCE_MIN_DWELL_S=120

# IA: confiança mínima para gerar alerta (abaixo disso vira só tarefa de revisão)
AI_ALERT_MIN_CONFIDENCE=0.8

# Prova de integridade (worker)
WORKER_INTERVAL_MS=15000
BATCH_MAX_EVENTS=100
# Custo de blockchain: cada lote = 1 transação. O lote só fecha com N eventos OU depois de X minutos.
# Aqui ficam em 1 evento / 0 min para a demonstração ser imediata.
# EM PRODUÇÃO use algo como BATCH_MIN_EVENTS=50 e BATCH_MAX_AGE_MIN=60 (ou 1440 para 1 lote por dia).
BATCH_MIN_EVENTS=1
BATCH_MAX_AGE_MIN=0

# mock = recibo simulado (padrão) | evm = ancora de verdade no contrato
ANCHOR_MODE=mock
# Só necessários com ANCHOR_MODE=evm (veja o pacote aerogaze-chain):
EVM_RPC_URL=
EVM_CHAIN_ID=
EVM_REGISTRY_ADDRESS=
EVM_ANCHOR_PRIVATE_KEY=

# Apenas para o seed de desenvolvimento
SEED_PASSWORD=aerogaze-dev-123

# Recibos adicionais na Solana Devnet (independentes da prova EVM).
SOLANA_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
# Array JSON de 64 bytes: configurar somente no ambiente do servidor.
SOLANA_SECRET_KEY=
