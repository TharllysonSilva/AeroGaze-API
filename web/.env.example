# URL da API (aerogaze-api). As chamadas saem do SERVIDOR do Next, então o navegador nunca vê o token
# e não há problema de CORS.
API_URL=http://localhost:3000

# Google Maps web: Demo Key de prototipo ou chave padrao restrita ao dominio.
# Lida no servidor em runtime e entregue ao navegador para carregar Maps JS.
# Nao use chave de conta de servico nem segredos de blockchain.
GOOGLE_MAPS_API_KEY=
